{
    "analyser": "@abs_builddir@/../../analyser-gt-norm.hfstol",
    "generator": "@abs_builddir@/../../generator-gt-norm.hfstol",
    "lexcroot": "@abs_srcdir@/../root.lexc",
    "nouns": {
        "lexcfile": "@abs_srcdir@/../stems/nouns.lexc",
        "lemmatags": ["+N+Sg+Nom", "+N+Pl+Nom"],
        "exclusions": ["(CmpN/Only|\\+Gen\\+|\\+Der\\+|\\+CmpN/Suff|\\+Use/MT)"]
    },
    "adjectives": {
        "lexcfile": "@abs_srcdir@/../stems/adjectives.lexc",
        "lemmatags": ["+A+Sg+Nom"]
    },
    "propernouns": {
        "lexcfile": "@abs_srcdir@/../stems/sma-propernouns.lexc",
        "lemmatags": ["+N+Prop+Sg+Nom"]
    },
    "verbs": {
        "lexcfile": "@abs_srcdir@/../stems/verbs.lexc",
        "lemmatags": ["+V+Inf"],
        "exclusions": ["(NEG|LEA|Use/Mt)"]
    },
    "otherlexcs": [
        "@abs_srcdir@/../stems/adpositions.lexc",
        "@abs_srcdir@/../stems/adverbs.lexc",
        "@abs_srcdir@/../stems/numerals.lexc",
        "@abs_srcdir@/../stems/conjunctions.lexc",
        "@abs_srcdir@/../stems/interjections.lexc",
        "@abs_srcdir@/../stems/numerals.lexc",
        "@abs_srcdir@/../stems/pronouns.lexc",
        "@abs_srcdir@/../affixes/abbreviations.lexc",
        "@abs_srcdir@/../affixes/adjectives.lexc",
        "@abs_srcdir@/../affixes/numerals.lexc",
        "@abs_srcdir@/../affixes/possessive-suffixes.lexc",
        "@abs_srcdir@/../affixes/propernouns.lexc",
        "@abs_srcdir@/../affixes/symbols.lexc",
        "@abs_srcdir@/../affixes/verbs.lexc",
        "@abs_srcdir@/../clitics.lexc",
        "@abs_srcdir@/../compounding.lexc",
        "@abs_builddir@/../generated_files/smi-sma-abbreviations.lexc",
        "@abs_builddir@/../generated_files/smi-sma-acronyms.lexc",
        "@abs_builddir@/../generated_files/smi-sma-arabic_roman_digits.lexc",
        "@abs_builddir@/../generated_files/smi-sma-digits.lexc",
        "@abs_builddir@/../generated_files/mul-sma-punctuation.lexc",
        "@abs_builddir@/../generated_files/mul-sma-symbols.lexc"
    ]
}
